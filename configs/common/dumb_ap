# CONFIG_PACKAGE_dawn is not set
# CONFIG_PACKAGE_luci-app-dawn is not set

### usteer
# CONFIG_PACKAGE_usteer=y
# CONFIG_PACKAGE_luci-app-usteer=y

# language
CONFIG_LUCI_LANG_pl=y

####### REPLACE CRYPTOLIB #####
# Remove section and copy from config/common/ a cryptolib section that you need.
CONFIG_PACKAGE_wpad-basic-mbedtls=m
CONFIG_PACKAGE_wpad-mbedtls=y
#######

# Use newer wifi configuration

# Enable WED (Wireless Ethernet Dispatch) for L2
# Also it is important to enable HW offload and
# do not disable firewall on dumb ap's.
# NOTE: The bridger would be installed but can be removed via rc.local because
# on Quantum Fiber W1700k when NPU is enabled and wireless clients have been
# disconnected after a while, later you will have difficulties to have
# more than 1 mbit bandwidth.
CONFIG_PACKAGE_bridger=y

# Speedtest tools
CONFIG_PACKAGE_librespeed-go=y

CONFIG_ALL_KMODS=y
CONFIG_ALL_NONSHARED=y
CONFIG_AUTOREMOVE=y

# Temporary adding for testing - https://github.com/openwrt/openwrt/pull/24038
CONFIG_PACKAGE_kmod-nf-conntrack-bridge=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nft-flow-offload=y
CONFIG_PACKAGE_kmod-nft-bridge=y
# optional
CONFIG_PACKAGE_kmod-br-netfilter=y
